<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <OpenCVRoot>D:\OPENCV\opencv_500\opencv\build</OpenCVRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <IncludePath>$(OpenCVRoot)\include;$(OpenCVRoot)\include\opencv2;$(IncludePath)</IncludePath>
    <LibraryPath>$(OpenCVRoot)\x64\vc16\lib;$(LibraryPath)</LibraryPath>
    <LocalDebuggerEnvironment>PATH=$(OpenCVRoot)\x64\vc16\bin;%PATH%
$(LocalDebuggerEnvironment)</LocalDebuggerEnvironment>
    <LocalDebuggerMergeEnvironment>true</LocalDebuggerMergeEnvironment>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>opencv_world500d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
